NODE_ENV=production
PORT=5000

# ── Database ───────────────────────────────────────────────────────────────────
# In production, set DATABASE_URL to your hosted Postgres endpoint.
# Leave DATABASE_URL unset for local dev — the DB_* vars below are used instead.
# DATABASE_URL=postgresql://user:password@host:5432/database

DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_pos
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h

# ── CORS (optional) ────────────────────────────────────────────────────────────
# Only set when the frontend lives on a different domain than the backend.
# FRONTEND_URL=https://app.yourdomain.com
